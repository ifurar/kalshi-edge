# Copy this file to .env and fill in your keys. Never commit the real .env.

# Required: sportsbook odds, used to compute de-vigged "fair" probabilities.
# Sign up at https://the-odds-api.com -- free tier exists but is low-volume;
# player props cost extra credits per event, so budget for a paid tier once
# you're scanning full slates regularly.
ODDS_API_KEY=

# Optional for now: Kalshi's public market-data endpoints (everything
# scan.py uses today) don't require auth. You'll only need this once you
# build trade_stub.py out for real order placement.
KALSHI_API_KEY=
